<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_control</name>
  <version>0.0.0</version>
  <description>
    Path-tracking controllers (pure pursuit, follow-the-gap, PID), safety and
    deadman gate nodes, and the RL drive-command layer.
  </description>
  <maintainer email="dev@example.com">maintainers</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>f1tenth_interfaces</depend>
  <exec_depend>f1tenth_rl_agent</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>f1tenth_rl_agent</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
