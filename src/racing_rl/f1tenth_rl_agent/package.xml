<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_rl_agent</name>
  <version>0.1.0</version>
  <description>
    ROS 2 nodes that run a trained F1TENTH QRSAC policy in closed loop against the
    f1tenth_gym_ros simulator. Builds the 384-dim observation (390 with the opponent
    block) from odometry and the track centerline, runs the policy, and publishes
    Ackermann drive commands.
  </description>
  <maintainer email="dev@todo.todo">f1tenth-genesis</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>f1tenth_interfaces</exec_depend>
  <!-- Shared observation/action format reference (parity test guards interfaces.py
       against it). -->
  <exec_depend>f1tenth_contract</exec_depend>
  <exec_depend>f1tenth_policy</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>f1tenth_contract</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
