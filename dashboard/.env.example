# Copy to dashboard/.env. Git ignores .env. The Next.js app does not read this file.
# Railway Postgres connection string.
DATABASE_URL=

# Tigris keys stay in this file, under dashboard/.
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

FLASK_URL=http://127.0.0.1:5000
