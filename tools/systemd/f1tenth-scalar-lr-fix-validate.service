[Unit]
Description=F1TENTH scalar-LR fix validation: 100M from-noise pcplus2b recipe seed 42
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/projects/F1tenth/training
Environment=WANDB_MODE=online
Environment=WANDB_GROUP=long-horizon-2b-sensors
Environment=PYTHONUNBUFFERED=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=CC=/home/ubuntu/miniconda3/bin/x86_64-conda-linux-gnu-cc
Environment=CXX=/home/ubuntu/miniconda3/bin/x86_64-conda-linux-gnu-c++
Environment=PATH=/home/ubuntu/miniconda3/bin:/home/ubuntu/projects/F1tenth/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/projects/F1tenth/tools/scalar_lr_fix_validate.sh
Restart=no
TimeoutStopSec=120
KillMode=mixed
StandardOutput=append:/home/ubuntu/projects/F1tenth/training/outputs/runs/scalar-lr-fix-validate-a001-chain.log
StandardError=append:/home/ubuntu/projects/F1tenth/training/outputs/runs/scalar-lr-fix-validate-a001-chain.log
SyslogIdentifier=f1tenth-scalar-lr-fix-validate

[Install]
WantedBy=default.target
