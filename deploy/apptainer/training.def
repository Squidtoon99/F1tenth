# Apptainer definition for offboard RL training on HPC.
# Build:  apptainer build training.sif deploy/apptainer/training.def
# Run:    apptainer run --nv training.sif   (--nv exposes the GPU)
# Smoke:  apptainer exec --nv training.sif python3 -c \
#           'import torch, warp; assert torch.cuda.is_available(); warp.get_device("cuda:0")'
#
Bootstrap: docker
From: nvidia/cuda:12.9.1-devel-ubuntu22.04

%files
    training /opt/f1tenth/training
    libs /opt/f1tenth/libs

%post
    apt-get update && apt-get install -y --no-install-recommends python3-pip git
    cd /opt/f1tenth/training
    python3 -m pip install -r requirements-gpu.txt \
        --extra-index-url https://download.pytorch.org/whl/cu130

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/f1tenth/training
    export WARP_CACHE_PATH=/tmp/f1tenth-warp-cache

%test
    export PYTHONPATH=/opt/f1tenth/training
    export WARP_CACHE_PATH=/tmp/f1tenth-warp-cache
    python3 -c 'import torch, warp; from f1tenth_sim import VehicleParams, WarpVehicleSim; sim = WarpVehicleSim(VehicleParams(), 1, device="cpu"); sim.step(torch.zeros(1, 2))'
    python3 /opt/f1tenth/training/standalone_trainer.py --help >/dev/null

%runscript
    cd /opt/f1tenth/training
    exec python3 standalone_trainer.py "$@"
