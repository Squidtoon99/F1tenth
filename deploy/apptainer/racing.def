# Apptainer definition to run the generic racing image on hosts that prefer
# Apptainer over Docker (e.g. some HPC/eval nodes). It mirrors Dockerfile.runtime.
# Prefer converting the built Docker image directly:
#   apptainer build racing.sif docker-daemon://f1tenth-racing:develop
# This .def is provided for a from-scratch build if needed.
#
# Scaffold placeholder.
Bootstrap: docker
From: ros:humble-ros-base

%files
    src /ws/src
    libs /ws/libs
    deploy/docker/entrypoint.sh /entrypoint.sh

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions python3-rosdep python3-pip
    source /opt/ros/humble/setup.bash
    cd /ws
    rosdep init || true
    rosdep update
    rosdep install --from-paths src libs --ignore-src -y -r || true
    colcon build --merge-install
    chmod +x /entrypoint.sh

%runscript
    exec /entrypoint.sh ros2 launch f1tenth_bringup race.launch.py "$@"
