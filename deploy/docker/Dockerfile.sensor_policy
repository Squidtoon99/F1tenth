# syntax=docker/dockerfile:1
# Sensor-policy runtime: JetPack 6 iGPU PyTorch + ROS 2 Humble + full src/ workspace.
#
# GENERIC — no per-car config and no policy weights. Mount /config and /policies
# at runtime. Supports device:=cpu and device:=cuda in the same image.
#
# Target: Jetson Orin Nano 8 GB, L4T R36.4.x / JetPack 6.2.x (CUDA 12.6).
# Base pin: NVIDIA PyTorch 24.09-py3-igpu (Ubuntu 22.04 Jammy, CUDA 12.6).
#
# Build natively on linux/arm64 (Jetson or arm64 builder). The -igpu base is
# arm64-only — do not certify amd64/QEMU builds.
#
#   TARGET=sensor_policy deploy/scripts/build_image.sh
#   deploy/docker/smoke_sensor_policy.sh
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:c652f021080c2d327fe7c14ae898fef1ba7dd3b756f15bff1455612f32b7cc0c

FROM ${BASE_IMAGE} AS ros_base
ARG BASE_IMAGE
ENV ROS_DISTRO=humble
ENV F1TENTH_SENSOR_POLICY_BASE=${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-lc"]

RUN . /etc/os-release \
    && if [ "${ID}" != "ubuntu" ] || [ "${VERSION_CODENAME}" != "jammy" ]; then \
         echo "sensor-policy requires Ubuntu Jammy for ROS 2 Humble (got ${PRETTY_NAME})" >&2; \
         exit 1; \
       fi \
    && apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg2 lsb-release ca-certificates git \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
      http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
      > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-rosdep \
      python3-vcstool \
      python3-pip \
      ros-humble-ros-base \
      ros-humble-ackermann-msgs \
      ros-humble-joy \
      ros-humble-teleop-tools \
      ros-humble-urg-node \
      ros-humble-serial-driver \
      ros-humble-asio-cmake-module \
      ros-humble-diagnostic-updater \
      ros-humble-tf-transformations \
      ros-humble-slam-toolbox \
      ros-humble-rosbridge-server \
      ros-humble-nav2-map-server \
      ros-humble-nav2-lifecycle-manager \
      python3-scipy \
      python3-transforms3d \
    && (apt-get install -y --no-install-recommends ros-humble-sick-scan-xd \
        || echo "sick_scan_xd unavailable on this arch; build from source if needed") \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir numpy cython \
    && rosdep init || true

RUN mkdir -p /etc/f1tenth \
    && python3 - <<'PY'
import json
import os

import torch

pins = {
    "base_image": os.environ.get("F1TENTH_SENSOR_POLICY_BASE", ""),
    "ros_distro": os.environ.get("ROS_DISTRO", ""),
    "torch": torch.__version__,
    "cuda": torch.version.cuda,
    "cudnn": torch.backends.cudnn.version(),
}
with open("/etc/f1tenth/sensor_policy_pins.json", "w", encoding="utf-8") as fh:
    json.dump(pins, fh, indent=2, sort_keys=True)
    fh.write("\n")
print(json.dumps(pins, sort_keys=True))
PY

# ---- build stage: complete colcon workspace (training/ excluded) ----
FROM ros_base AS build
ARG RANGE_LIBC_WITH_CUDA=OFF
WORKDIR /ws
COPY src ./src
COPY libs ./libs

RUN test -f src/localization/range_libc/pywrapper/setup.py \
    || (echo "range_libc submodule missing; run: git submodule update --init src/localization/range_libc" >&2 && exit 1)

RUN touch src/localization/range_libc/COLCON_IGNORE \
    && WITH_CUDA=${RANGE_LIBC_WITH_CUDA} pip3 install --no-cache-dir ./src/localization/range_libc/pywrapper

RUN source /opt/ros/humble/setup.bash \
    && rosdep update \
    && (rosdep install --from-paths src libs --ignore-src -y -r || true) \
    && colcon build --merge-install --packages-ignore range_lib \
      --cmake-args -DBUILD_TESTING=OFF

# ---- runtime stage ----
FROM ros_base AS runtime
ARG RANGE_LIBC_WITH_CUDA=OFF
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
WORKDIR /ws
COPY --from=build /ws/install /ws/install
COPY src/localization/range_libc ./src/localization/range_libc
RUN WITH_CUDA=${RANGE_LIBC_WITH_CUDA} pip3 install --no-cache-dir ./src/localization/range_libc/pywrapper
COPY deploy/docker/entrypoint.sh /entrypoint.sh
COPY deploy/docker/smoke_sensor_policy.sh /usr/local/bin/smoke_sensor_policy.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/smoke_sensor_policy.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "f1tenth_bringup", "sensor_policy.launch.py"]
