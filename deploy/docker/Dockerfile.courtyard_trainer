# syntax=docker/dockerfile:1
# Online courtyard_2 PPO trainer. Completely separate from Dockerfile.gigaflow
# (the on-car runtime). CUDA / PyTorch training image for a GPU host.
#
#   TARGET=courtyard_trainer deploy/scripts/build_image.sh
#   TARGET=courtyard_trainer deploy/scripts/snapshot.sh
#
# Run (checkpoint is mounted, never baked):
#   docker run --rm --gpus all \
#     -v /opt/f1tenth/policies:/opt/f1tenth/policies:ro \
#     -v /opt/f1tenth/outputs/courtyard_ppo:/opt/f1tenth/outputs/courtyard_ppo \
#     f1tenth-courtyard-trainer:courtyard-trainer
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/gigaflow/src
ENV WARP_CACHE_PATH=/tmp/f1tenth-warp-cache
ENV CHECKPOINT=/opt/f1tenth/policies/actor_005700.pt
ENV RUN_DIR=/opt/f1tenth/outputs/courtyard_ppo
ENV DEVICE=cuda

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/gigaflow
COPY gigaflow/requirements-gpu.txt /opt/gigaflow/requirements-gpu.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir -r /opt/gigaflow/requirements-gpu.txt \
         --extra-index-url https://download.pytorch.org/whl/cu130

# Copies gigaflow (baked_condition loader + courtyard_ppo.yaml 60 A / 20 A).
COPY gigaflow /opt/gigaflow
COPY deploy/docker/run_courtyard_ppo.sh /usr/local/bin/run_courtyard_ppo.sh
RUN chmod +x /usr/local/bin/run_courtyard_ppo.sh \
    && mkdir -p /opt/f1tenth/policies /opt/f1tenth/outputs/courtyard_ppo \
    && test -f /opt/gigaflow/assets/courtyard_2_centerline.csv \
    && test -f /opt/gigaflow/configs/courtyard_ppo.yaml \
    && python3 -m gigaflow_f1tenth.cli train-courtyard --help >/dev/null

WORKDIR /opt/gigaflow
ENTRYPOINT ["/usr/local/bin/run_courtyard_ppo.sh"]
