# syntax=docker/dockerfile:1.4
# Runtime (car) image: base + a baked colcon install of the racing packages.
# GENERIC — contains no per-car config and no policy weights. Those are supplied at
# runtime by mounting a per-car overlay at /config and a policy at /policies.
#
# Build from the repo root via deploy/scripts/build_image.sh.
#   RANGE_LIBC_WITH_CUDA=OFF (default) — CPU range_libc, target runtime (~3.3 GB).
#   RANGE_LIBC_WITH_CUDA=ON — GPU range_libc compiled in an NGC stage, copied into
#     the slim runtime (target runtime-cuda, ~3.5–4 GB). Ships L4T libcudart (JetPack
#     6.1 / CUDA 12.6) so the on-car driver accepts the runtime. NGC pytorch is
#     desktop/SBSA CUDA; copying that libcudart fails particle_filter with
#     "CUDA driver version is insufficient for CUDA runtime version".
#     nvidia-container-toolkit still does not inject user-space CUDA on Jetson.
ARG ROS_DISTRO=humble
ARG CUDA_ARCH=sm_87
ARG CUDA_BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:c652f021080c2d327fe7c14ae898fef1ba7dd3b756f15bff1455612f32b7cc0c
# L4T CUDA 12.6.11 runtime (linux/arm64) — source of Jetson-compatible libcudart.
ARG L4T_CUDA_IMAGE=nvcr.io/nvidia/l4t-cuda:12.6.11-runtime@sha256:49853e9fe2a0305efa51fcbb3426eea1bca658085f2d26bb40347711434849b1
# ROS Humble apt numpy; range_libc must compile against the same ABI as f1tenth-base.
ARG RUNTIME_NUMPY=1.21.5

# ---- CUDA range_libc compile (NGC base has nvcc + headers; output is a .so only) ----
FROM ${CUDA_BASE_IMAGE} AS range_libc_cuda
ARG CUDA_ARCH
ARG RUNTIME_NUMPY
SHELL ["/bin/bash", "-lc"]
WORKDIR /src
COPY src/localization/range_libc ./range_libc
RUN test -f range_libc/pywrapper/setup.py \
    || (echo "range_libc submodule missing; run: git submodule update --init src/localization/range_libc" >&2 && exit 1)
RUN cd range_libc/pywrapper \
    && grep -qF 'arch=sm_62' setup.py \
    || { echo "patch: sm_62 token missing in setup.py" >&2; exit 1; } \
    && sed -i "s/-arch=sm_62/-arch=${CUDA_ARCH}/" setup.py \
    && grep -qF "arch=${CUDA_ARCH}" setup.py \
    || { echo "patch: sm_62 -> ${CUDA_ARCH} substitution failed" >&2; exit 1; } \
    && grep -qF 'gcc-8' setup.py \
    || { echo "patch: gcc-8 lines missing in setup.py" >&2; exit 1; } \
    && sed -i '/which gcc-8/d; /which g++-8/d' setup.py \
    && ! grep -qF 'gcc-8' setup.py \
    || { echo "patch: gcc-8 line removal failed" >&2; exit 1; }
RUN cd /src \
    && touch range_libc/COLCON_IGNORE \
    && pip3 install --no-cache-dir "numpy==${RUNTIME_NUMPY}" \
    && python3 -c "import numpy; assert numpy.__version__ == '${RUNTIME_NUMPY}', numpy.__version__" \
    && WITH_CUDA=ON pip3 install --no-cache-dir --no-build-isolation ./range_libc/pywrapper
RUN python3 - <<'PY'
from importlib.metadata import distribution
import shutil
from pathlib import Path

dist = distribution("range_libc")
files = list(dist.files)
so_entries = [entry for entry in files if str(entry).endswith(".so")]
if not so_entries:
    raise SystemExit(f"range_libc install has no .so in RECORD: {[str(f) for f in files]}")

site_root = so_entries[0].locate().parent
out = Path("/out/range_libc_pkg")
copied = []
for entry in files:
    src = entry.locate()
    if src is None:
        raise SystemExit(f"cannot locate installed file: {entry}")
    rel = Path(str(entry))
    dest = out / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest)
    copied.append(str(rel))

for meta in site_root.glob("range_libc*.dist-info"):
    rel = meta.relative_to(site_root)
    dest = out / rel
    if meta.is_dir():
        shutil.copytree(meta, dest, dirs_exist_ok=True)
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(meta, dest)
    copied.append(str(rel))

if not any("range_libc" in name and name.endswith(".so") for name in copied):
    raise SystemExit(f"range_libc .so not staged; copied {copied}")
print("staged range_libc from", site_root)
print("artifacts:", sorted(copied))
PY

# L4T libcudart matches the Jetson driver. Do not copy libcudart from the NGC
# compile stage — that library is desktop/SBSA CUDA and rejects L4T driver 540.x.
FROM ${L4T_CUDA_IMAGE} AS l4t_cudart
SHELL ["/bin/bash", "-lc"]
RUN mkdir -p /out/cuda_runtime \
    && so="$(find /usr/local/cuda /usr/local/cuda-* /usr/lib -name 'libcudart.so.12*' \
         \( -type f -o -type l \) 2>/dev/null | head -n 1)" \
    && test -n "${so}" \
    || { echo "libcudart.so.12 not found in L4T CUDA image" >&2; \
         find /usr/local /usr/lib -name 'libcudart*' >&2 || true; exit 1; } \
    && real="$(readlink -f "${so}")" \
    && test -f "${real}" \
    || { echo "libcudart path ${so} did not resolve to a file" >&2; exit 1; } \
    && cp -a "${real}" /out/cuda_runtime/"$(basename "${real}")" \
    && ln -sfn "$(basename "${real}")" /out/cuda_runtime/libcudart.so.12 \
    && ln -sfn libcudart.so.12 /out/cuda_runtime/libcudart.so \
    && test -e /out/cuda_runtime/libcudart.so.12 \
    || { echo "failed to stage L4T libcudart" >&2; ls -l /out/cuda_runtime >&2; exit 1; }

# ---- CUDA runtime: slim f1tenth-base + copied GPU extension ----
FROM f1tenth-base:latest AS build-cuda
ARG ROS_DISTRO
SHELL ["/bin/bash", "-lc"]
WORKDIR /ws
COPY src ./src
COPY libs ./libs
RUN test -f src/localization/range_libc/pywrapper/setup.py \
    || (echo "range_libc submodule missing; run: git submodule update --init src/localization/range_libc" >&2 && exit 1) \
    && touch src/localization/range_libc/COLCON_IGNORE
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && rosdep update \
    && rosdep install --from-paths src libs --ignore-src -y -r || true \
    && colcon build --merge-install --packages-ignore range_lib

FROM f1tenth-base:latest AS runtime-cuda
ARG ROS_DISTRO
ARG RUNTIME_NUMPY
ENV ROS_DISTRO=${ROS_DISTRO}
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
SHELL ["/bin/bash", "-lc"]
WORKDIR /ws
COPY --from=build-cuda /ws/install /ws/install
COPY --from=l4t_cudart /out/cuda_runtime /usr/local/cuda/lib64
RUN echo /usr/local/cuda/lib64 > /etc/ld.so.conf.d/range-libc-cuda.conf \
    && ldconfig
COPY --from=range_libc_cuda /out/range_libc_pkg /tmp/range_libc_pkg
RUN bash <<EOF
set -euo pipefail

if [[ ! -d /tmp/range_libc_pkg ]]; then
  echo "range_libc staging dir /tmp/range_libc_pkg is missing" >&2
  exit 1
fi

so_count="\$(find /tmp/range_libc_pkg -name 'range_libc*.so' | wc -l)"
if [[ "\${so_count}" -lt 1 ]]; then
  echo "no range_libc .so under /tmp/range_libc_pkg" >&2
  exit 1
fi

SITE="\$(python3 - <<'PY'
import site
candidates = [p for p in site.getsitepackages() if "dist-packages" in p]
if not candidates:
    raise SystemExit("no dist-packages path in site.getsitepackages()")
print(candidates[0])
PY
)"
if [[ -z "\${SITE}" || ! -d "\${SITE}" ]]; then
  echo "could not resolve pip site-packages (got: \${SITE})" >&2
  exit 1
fi

cp -a /tmp/range_libc_pkg/. "\${SITE}/"

SO="\$(find "\${SITE}" -maxdepth 1 -name 'range_libc*.so' -print -quit)"
if [[ -z "\${SO}" ]]; then
  echo "range_libc .so missing after copy under \${SITE}" >&2
  exit 1
fi

if ! readelf -d "\${SO}" | grep -qE '[[:space:]]Shared library: \\[libcudart\\.so'; then
  echo "range_libc .so lacks DT_NEEDED libcudart (CPU fallback build?)" >&2
  readelf -d "\${SO}" | grep 'Shared library:' >&2 || true
  exit 1
fi

if ! ldd "\${SO}" | grep -qE 'libcudart\\.so\\.12 => /usr/local/cuda/lib64/libcudart'; then
  echo "libcudart not resolved for range_libc .so after staging CUDA runtime" >&2
  ldd "\${SO}" >&2 || true
  exit 1
fi

runtime_numpy="\$(python3 -c 'import numpy; print(numpy.__version__)')"
if [[ "\${runtime_numpy}" != "${RUNTIME_NUMPY}" ]]; then
  echo "runtime numpy \${runtime_numpy} != ${RUNTIME_NUMPY} (range_libc ABI mismatch)" >&2
  exit 1
fi

echo "range_libc CUDA-linked .so installed: \${SO} (numpy \${runtime_numpy})"
EOF
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.4.1"
RUN python3 -c "import numpy; assert numpy.__version__ == '${RUNTIME_NUMPY}', numpy.__version__"
RUN bash <<EOF
set -euo pipefail
PF=/ws/install/share/f1tenth_localization/config/pf_params.yaml
test -f "\${PF}" || { echo "pf_params.yaml not found at \${PF}" >&2; exit 1; }
grep -qF "range_method: 'rm'" "\${PF}" \
  || { echo "pf_params.yaml missing default range_method: 'rm'" >&2; exit 1; }
sed -i "s/range_method: 'rm'/range_method: 'rmgpu'/" "\${PF}"
grep -qF "range_method: 'rmgpu'" "\${PF}" \
  || { echo "pf_params.yaml range_method sed to rmgpu failed" >&2; exit 1; }
EOF
COPY deploy/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "f1tenth_bringup", "race.launch.py"]

# ---- CPU build stage (default path) ----
FROM f1tenth-base:latest AS build
ARG ROS_DISTRO
SHELL ["/bin/bash", "-lc"]
WORKDIR /ws
COPY src ./src
COPY libs ./libs
RUN test -f src/localization/range_libc/pywrapper/setup.py \
    || (echo "range_libc submodule missing; run: git submodule update --init src/localization/range_libc" >&2 && exit 1)
RUN touch src/localization/range_libc/COLCON_IGNORE \
    && WITH_CUDA=OFF pip3 install --no-cache-dir ./src/localization/range_libc/pywrapper
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && rosdep update \
    && rosdep install --from-paths src libs --ignore-src -y -r || true \
    && colcon build --merge-install --packages-ignore range_lib

# ---- CPU runtime stage (default target) ----
FROM f1tenth-base:latest AS runtime
ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}
SHELL ["/bin/bash", "-lc"]
WORKDIR /ws
COPY --from=build /ws/install /ws/install
COPY src/localization/range_libc ./src/localization/range_libc
RUN WITH_CUDA=OFF pip3 install --no-cache-dir ./src/localization/range_libc/pywrapper
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.4.1"
COPY deploy/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "f1tenth_bringup", "race.launch.py"]
