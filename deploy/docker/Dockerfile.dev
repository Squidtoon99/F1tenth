# syntax=docker/dockerfile:1
# Dev image: base + developer conveniences. Source is mounted live at /ws (see
# tools/dev.sh), so nothing is baked in — you build the workspace inside.
ARG ROS_DISTRO=humble
# Base image ref. Defaults to the locally-built base; seed/CI builds can point this
# at the published base (e.g. squidtoon99/f1tenth-base:latest) via --build-arg.
ARG BASE_IMAGE=f1tenth-base:latest
FROM ${BASE_IMAGE}
ARG ROS_DISTRO

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      vim less bash-completion python3-pip \
      ros-${ROS_DISTRO}-foxglove-bridge \
      ros-${ROS_DISTRO}-rviz2 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch for policy inference (the trainer runs natively on the host GPU
# box; the ROS image never needs CUDA). The runtime (car) image installs the same
# wheel (see Dockerfile.runtime); a Jetson needs a JetPack/CUDA-matched wheel.
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.4.1"

# Auto-source ROS + the RealSense overlay + the workspace overlay (if built) for
# interactive shells.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc \
    && echo "[ -f /opt/realsense_ros/setup.bash ] && source /opt/realsense_ros/setup.bash" >> /etc/bash.bashrc \
    && echo "[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash" >> /etc/bash.bashrc

WORKDIR /ws
CMD ["bash"]
